# Credenciales de la base de datos.
# Copia este archivo a .env y cambia el valor:  cp .env.example .env
# .env está en .gitignore, nunca se sube al repositorio.

# Única fuente de la contraseña. La usan tanto MySQL como la app Spring Boot,
# así que es imposible que se desincronicen.
DB_PASSWORD=pon_aqui_tu_contrasena

# Opcionales: tienen valores por defecto en docker-compose.yml
# DB_USERNAME=root
# MYSQL_DATABASE=fluffy_yarn_db

# Clave de firma de los tokens JWT.
# HS256 usa los bytes de este string tal cual, asi que necesita 32 bytes minimos:
# 32 caracteres hexadecimales ya cumple, pero conviene usar mas por margen.
# Genera una con:  openssl rand -hex 32
JWT_SECRET=pon_aqui_tu_secreto_de_64_caracteres_hexadecimales

# Usuario admin inicial que crea el InitialAdminSeeder al arrancar.
# Es con el que tu cliente gestiona la tienda, asi que cambia el password antes de
# entregarle el proyecto.
# ADMIN_PASSWORD no tiene valor por defecto en application.properties: si falta,
# la app no arranca. Pon una propia, no dejes la de ejemplo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_esta_password_por_una_propia
